    "from sklearn.neighbors import KNeighborsClassifier\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.metrics import classification_report, confusion_matrix, accuracy_score\n",
    "from sklearn.utils import resample\n",
    "\n",
    "# Combine specific TRAINING split (X_train and y_clf_train)\n",
    "train_data = X_train.copy()\n",
    "train_data['success'] = y_clf_train\n",
    "\n",
    "# Separate Majority (1) and Minority (0) classes\n",
    "majority = train_data[train_data.success == 1]\n",
    "minority = train_data[train_data.success == 0]\n",
    "\n",
    "# Upsample Minority Class\n",
    "minority_upsampled = resample(minority, \n",
    "                              replace=True,     # sample with replacement\n",
    "                              n_samples=len(majority),    # match majority count\n",
    "                              random_state=42)\n",
    "\n",
    "# Combine back into a new Balanced Training Set\n",
    "train_balanced = pd.concat([majority, minority_upsampled])\n",
    "\n",
    "# Split back into X and y\n",
    "X_train_bal = train_balanced.drop('success', axis=1)\n",
    "y_train_bal = train_balanced['success']\n",
    "\n",
    "print(f\"Original Training Class 0 count: {sum(y_clf_train == 0)}\")\n",
    "print(f\"Balanced Training Class 0 count: {sum(y_train_bal == 0)}\")\n",
    "\n",
    "# --- Model A: K-Nearest Neighbors (KNN) ---\n",
    "knn = KNeighborsClassifier(n_neighbors=30, weights='distance')\n",
    "knn.fit(X_train_bal, y_train_bal)\n",
    "\n",
    "# Predict\n",
    "y_pred_knn = knn.predict(X_val)\n",
    "\n",
    "print(\"--- KNN Performance ---\")\n",
    "print(classification_report(y_clf_val, y_pred_knn))\n",
    "\n",
    "rf_bal = RandomForestClassifier(random_state=42, n_estimators=100)\n",
    "rf_bal.fit(X_train_bal, y_train_bal)\n",
    "\n",
    "# get the PROBABILITIES\n",
    "probs_val = rf_bal.predict_proba(X_val)[:, 1]  # Probability of class 1\n",
    "\n",
    "# Custom Threshold -> if prob > 0.90, predict 1. Else predict 0.\n",
    "threshold = 0.90\n",
    "y_pred_adjusted = (probs_val >= threshold).astype(int)\n",
    "\n",
    "print(f\"--- Random Forest (Threshold = {threshold}) ---\")\n",
    "print(classification_report(y_clf_val, y_pred_adjusted))"
   ]
