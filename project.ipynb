      "Name: umami, dtype: float64\n"
     ]
    }
   ],
   "source": [
    "target_cols = ['aroma_intensity', 'umami']\n",
    "numeric_cols = data.select_dtypes(include=np.number).columns.tolist()\n",
    "corr_matrix = data[numeric_cols].corr(method='pearson')\n",
    "for col in target_cols:\n",
    "    correlations = corr_matrix[col].drop(col)\n",
    "    top5 = correlations.abs().sort_values(ascending=False).head(5)\n",
    "    print(f\"\\nTop 5 correlations for {col}:\")\n",
    "    print(top5)"
   ]
  },
  {
