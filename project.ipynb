    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "# Define Features (X) and Targets (y)\n",
    "X = df_dummies.drop(columns=['overall_appreciation', 'success', 'product_id', 'name', 'description', 'OA_bins'], errors='ignore')\n",
    "X = X.select_dtypes(include=['number'])\n",
    "\n",
    "y_reg = df_dummies['overall_appreciation'] # Target for Regression\n",
    "y_clf = df_dummies['success']              # Target for Classification\n",
    "\n",
    "# Scale Data \n",
    "scaler = StandardScaler()\n",
    "X_scaled = pd.DataFrame(scaler.fit_transform(X), columns=X.columns)\n",
    "\n",
    "# Train: First 1600 rows\n",
    "# Validation: Next 200 rows (1600 to 1800)\n",
    "# Test: Last 200 rows (1800 to 2000)\n",
    "\n",
    "# Slice the feature matrix\n",
    "X_train = X_scaled.iloc[:1600]\n",
    "X_val   = X_scaled.iloc[1600:1800]\n",
    "X_test  = X_scaled.iloc[1800:]\n",
    "\n",
    "# Slice the targets\n",
    "y_reg_train = y_reg.iloc[:1600]\n",
    "y_reg_val   = y_reg.iloc[1600:1800]\n",
    "y_reg_test  = y_reg.iloc[1800:]\n",
    "\n",
    "y_clf_train = y_clf.iloc[:1600]\n",
    "y_clf_val   = y_clf.iloc[1600:1800]\n",
    "y_clf_test  = y_clf.iloc[1800:]\n",
    "\n",
    "print(f\"Train shape: {X_train.shape}, Val shape: {X_val.shape}, Test shape: {X_test.shape}\")"
